{
  "name": "password-manager-server",
  "version": "1.0.0",
  "description": "Personal password manager API — Fastify + TypeScript + Prisma",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push:test": "node --import tsx scripts/push-test-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:google": "tsx scripts/get-refresh-token.ts",
    "vault:recovery": "node --import tsx scripts/recover-vault.ts",
    "vault:migrate": "node --import tsx scripts/migrate-vault.ts",
    "vault:migrate:guard:test": "node --import tsx --test scripts/migration-target.test.ts",
    "vault:recovery:test": "node --import tsx --test scripts/recovery-backup.test.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.0.0",
    "@prisma/client": "^6.2.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "googleapis": "^172.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^6.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
